# JWT
JWT_SECRET=replace-with-at-least-32-character-secret
JWT_ISSUER=skillproof
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Security / CORS
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_VERIFICATION_URL=http://localhost:5173/verify-email
FRONTEND_PASSWORD_RESET_URL=http://localhost:5173/reset-password

# SMTP — local defaults use Mailpit. Replace these in production.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@skillproof.local
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_STARTTLS_REQUIRED=false
MAIL_SSL=false

# Bootstrap Admin
ADMIN_EMAIL=admin@skillproof.local
ADMIN_PASSWORD=change-me

# Spring
SPRING_PROFILES_ACTIVE=
